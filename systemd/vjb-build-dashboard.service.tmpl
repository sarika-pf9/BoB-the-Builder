[Unit]
Description=vjailbreak build dashboard (web UI for build_system)
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=${BOB_USER}
WorkingDirectory=${BOB_DIR}/dashboard
EnvironmentFile=${BOB_DIR}/bob.env
Environment=PATH=${BOB_DIR}/dashboard/venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=DASHBOARD_DATA_DIR=${BOB_DIR}/dashboard/data
ExecStart=${BOB_DIR}/dashboard/venv/bin/uvicorn app:app --host 0.0.0.0 --port ${BOB_DASHBOARD_PORT}
# Port 80 is a privileged port (<1024) - a non-root User= above can't bind it
# on its own. This ambient capability grants just that one privilege to the
# uvicorn process instead of running the whole service as root, and (unlike a
# setcap on the venv's python binary) survives the venv being recreated by a
# future re-run of install.sh.
#
# Deliberately NOT setting CapabilityBoundingSet= here. This service shells
# out to run build_system for every build (docker builds, then scripts under
# image_builder/scripts/ that call sudo for things like mount/losetup on the
# qcow2 image). CapabilityBoundingSet is a ceiling that's inherited by every
# child process this service ever forks, for the life of that whole process
# tree - clamping it down to just CAP_NET_BIND_SERVICE also strips CAP_SETUID/
# CAP_SETGID/CAP_AUDIT_WRITE/etc. from every build launched through the
# dashboard, which breaks sudo inside those builds even though sudo itself
# and the host are fine (a setuid-root binary can never exceed the bounding
# set of the process that invoked it). Leaving CapabilityBoundingSet unset
# keeps systemd's normal default bounding set, which already includes
# CAP_NET_BIND_SERVICE, so uvicorn still binds port 80 fine.
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
