# bob.env - the one settings file for BoB-the-Builder.
#
# Copy to $BOB_DIR/bob.env (default ~/bob_the_builder/bob.env) and edit:
#     mkdir -p ~/bob_the_builder
#     cp config/bob.env.example ~/bob_the_builder/bob.env
#
# Read by: build_system (builder/common/config.py), the dashboard (systemd
# EnvironmentFile=), install.sh and host-setup/*.sh. Plain KEY=VALUE lines -
# no spaces around "=", no shell expressions.
# A real environment variable with the same name always wins over this file.

# --- REQUIRED ---------------------------------------------------------------

# Your quay.io namespace (user or org). Images are pushed to
# quay.io/<this>/<repo>, and the qcow2 + controller reference them there.
# You must `docker login quay.io` as someone who can push to it.
BOB_QUAY_NAMESPACE=

# --- quay.io repos (create these 5 in your namespace first) -----------------
BOB_QUAY_REPO_V2V_HELPER=proj_v2v
BOB_QUAY_REPO_CONTROLLER=proj_controller
BOB_QUAY_REPO_UI=proj_ui
BOB_QUAY_REPO_VPWNED=proj_sdk
BOB_QUAY_REPO_AI=proj_ai

# --- vjailbreak source -----------------------------------------------------

# Dedicated checkout used ONLY by builds. Every build hard-resets and
# `git clean -ffdx`es it, so never point this at a checkout you work in.
BOB_VJB_REPO_DIR=/opt/build/vjailbreak
# Cloned by host-setup/30-vjailbreak-checkout.sh. Needs a GitHub SSH key
# on this host with read access to the repo.
BOB_VJB_REPO_URL=git@github.com:platform9/vjailbreak-code.git

# --- host ------------------------------------------------------------------

# Local mirror registry port (127.0.0.1 only). Set up by host-setup.
BOB_MIRROR_PORT=5051
# Port the dashboard listens on (0.0.0.0). No auth - keep it internal/VPN only.
BOB_DASHBOARD_PORT=80
# Go toolchain build_system downloads to ~/.local/go if `go` isn't on PATH.
BOB_GO_VERSION=1.23.4
